# Postgres connection string (pooled). Vercel injects this automatically once
# you connect the Neon storage integration in the dashboard — check the
# actual var name with `vercel env pull .env.local` before assuming
# DATABASE_URL (older Vercel Postgres integrations used POSTGRES_URL).
DATABASE_URL=

# Single admin login for /admin.
ADMIN_USERNAME=

# Output of `npm run hash-password -- <your-password>` (format: salt:hash).
# Never store the plaintext password anywhere.
ADMIN_PASSWORD_HASH=

# Random secret used to sign admin session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Email notification on new lead (resend.com). Without a verified sending
# domain, NOTIFY_EMAIL_TO must match the email of the Resend account itself.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=onboarding@resend.dev

# WhatsApp notification on new lead (callmebot.com — free, unofficial, fine
# for low-volume personal alerts). Get CALLMEBOT_APIKEY by messaging their
# bot from CALLMEBOT_PHONE once, per their site instructions.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
